FROM alpine:latest

# نصب پیش‌نیازها
RUN apk add --no-cache openssl bash wget

# دانلود مستقیم باینری از گیت‌هاب
RUN wget -O /usr/local/bin/mtg https://github.com/9seconds/mtg/releases/download/v2.1.7/mtg-linux-amd64 && \
    chmod +x /usr/local/bin/mtg

# کپی اسکریپت
COPY start.sh /start.sh
RUN chmod +x /start.sh && \
    sed -i 's/\r$//' /start.sh

WORKDIR /app
EXPOSE 443
ENTRYPOINT ["/start.sh"]
