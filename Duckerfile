FROM golang:1.21-alpine AS builder

# نصب پیش‌نیازها
RUN apk add --no-cache git make

# کلون و بیلد fakemtg
WORKDIR /build
RUN git clone https://github.com/9seconds/mtg.git . && \
    make && \
    cp mtg /usr/local/bin/fakemtg

# ========== مرحله نهایی ==========
FROM alpine:latest

RUN apk add --no-cache openssl envsubst

# کپی باینری و فایل‌ها
COPY --from=builder /usr/local/bin/fakemtg /usr/local/bin/
COPY config.toml /app/config.toml
COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

WORKDIR /app

# پورت داخلی
EXPOSE 443

ENTRYPOINT ["/entrypoint.sh"]
